pipeline {
    agent any

    triggers {
        // Planification automatique : Déclenchement tous les jours à 10h00 du matin
        cron('0 10 * * *')
    }

    options {
        // Limitation du nombre d'historiques de build conservés pour économiser de l'espace
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                // Étape 1 : Récupérer le code source depuis le dépôt Git/GitHub lié
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                // Étape 2 : Créer l'environnement virtuel Python et installer les dépendances nécessaires
                script {
                    if (isUnix()) {
                        sh '''
                            python3 -m venv venv
                            . venv/bin/activate
                            pip install --upgrade pip
                            pip install -r requirements.txt
                        '''
                    } else {
                        bat '''
                            python -m venv venv
                            call venv\\Scripts\\activate
                            python -m pip install --upgrade pip
                            pip install -r requirements.txt
                        '''
                    }
                }
            }
        }

        stage('Tests') {
            steps {
                // Étape 3 : Exécution de la suite de tests automatisée avec pytest
                // --junitxml=reports/result.xml génère un rapport lisible par Jenkins
                script {
                    if (isUnix()) {
                        sh '''
                            . venv/bin/activate
                            pytest --junitxml=reports/result.xml
                        '''
                    } else {
                        bat '''
                            call venv\\Scripts\\activate
                            pytest --junitxml=reports/result.xml
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            // Enregistre les résultats dans Jenkins à chaque fois
            junit 'reports/result.xml' 
        }
        success {
            // Envoie cet email si les tests passent au vert
            mail to: 'adam.ramzi@etu.uae.ac.ma',
                 subject: "✅ Succès du Build Jenkins : ${env.JOB_NAME} [${env.BUILD_NUMBER}]",
                 body: "Félicitations Adam, la suite de tests automatisés pour StudySearch est passée avec succès (100% au vert) !"
        }
        failure {
            // Envoie cet email si au moins un test échoue
            mail to: 'adam.ramzi@etu.uae.ac.ma',
                 subject: "❌ Échec du Build Jenkins : ${env.JOB_NAME} [${env.BUILD_NUMBER}]",
                 body: "Attention, une erreur s'est produite lors du dernier lancement des tests automatisés. Connecte-toi à Jenkins pour vérifier les logs de la console."
        }
    }
}
